#!name = WorkBuddy 自动签到
#!desc = 自动领取 WorkBuddy 每日签到积分 + 成长中心全套奖励（旅行礼物 / 派 Buddy / 任务 / 补登 / 连登兑换 / 盲盒），支持多账号。移植自 88lin/workbuddy-auto-signin。
#!author = xlzs001
#!homepage = https://github.com/88lin/workbuddy-auto-signin
#!icon = https://raw.githubusercontent.com/88lin/workbuddy-auto-signin/main/assets/cover.jpg
#!category = 签到
#!date = 2026-01-01
#!tag = 自动化

# ─── 使用前必读 ───────────────────────────────────────────────────────────
# 1. 下面所有地址已指向 https://github.com/xlzs001/workbuddy-loon（想换仓库就整段替换）。
# 2. 先用桌面端导出一次令牌，二选一：
#    · 多账号（推荐）：python3 accounts-slim.py wb-switch-accounts-*.json
#      把输出粘进 BoxJS 的「账号池」；也可以把 JSON 托管到自己的 URL 填进
#      WorkBuddy_AccountsURL，之后每轮自动拉取 + 缓存。
#    · 单账号：python3 export-token.py /path/to/workbuddy-auto-signin
#      再把 token / uid 填进 BoxJS 的「WorkBuddy 自动签到」面板。
#    多账号时整轮共享 WorkBuddy_Budget（默认 540 秒），每个账号分到
#    min(240, 总额/账号数) 秒，所以下面每一条 cron 的 timeout 都要大于 540。
# 3. MITM 只在「手机端自身会请求 copilot.tencent.com」时才有意义（用于自动抓
#    Authorization 更新令牌）。如果你的手机端不访问该域名，可以整段删掉 [MITM]，
#    只保留两条 cron；代价是令牌过期后要重新导出一次。
# ─────────────────────────────────────────────────────────────────────────

[Script]
# ① 令牌保鲜：手机端只要有带 Authorization 的请求打到 copilot.tencent.com，
#    就自动把最新令牌写回 BoxJS，避免手动反复导出。
http-request ^https?:\/\/copilot\.tencent\.com\/v2\/ script-path=https://raw.githubusercontent.com/xlzs001/workbuddy-loon/main/workbuddy.js, requires-body=false, tag=WorkBuddy令牌保鲜, timeout=10

# ② 每日签到 + 成长中心（每天 00:05）
cron "5 0 * * *" script-path=https://raw.githubusercontent.com/xlzs001/workbuddy-loon/main/workbuddy.js, tag=WorkBuddy每日签到, timeout=600, argument=auto

# ③ 成长中心轮询（每 4 小时）：先补签（未签才签），再跑成长中心
#    Buddy 旅行 1~4 小时就带回礼物，只在 00:05 跑一次礼物会压到第二天；
#    这一轮同时兜住「00:05 没开机 / 没网」导致的断签。
cron "0 */4 * * *" script-path=https://raw.githubusercontent.com/xlzs001/workbuddy-loon/main/workbuddy.js, tag=WorkBuddy成长轮询, timeout=600, argument=poll

# ④ 可选：Loon 卡片面板（Loon 版本较新才支持 [Panel]，不支持就直接删掉）
[Panel]
WorkBuddy = script-path=https://raw.githubusercontent.com/xlzs001/workbuddy-loon/main/workbuddy.js, argument=panel, title=WorkBuddy, interval=1800, timeout=30

[MITM]
hostname = %APPEND% copilot.tencent.com
